[
 {
  "arquivo": "treeGrowth-",
  "motivo": "Material depois do nome do item (Espada de cobre, não de cobre Espada)",
  "regex": "\\b([a-zA-Z_$][\\w$]*)\\.prefix\\+\" \"\\+([a-zA-Z_$][\\w$]*)\\b(?!\\()",
  "para": "$2+\" \"+$1.prefix"
 },
 {
  "arquivo": "persistence-",
  "motivo": "Material depois do nome do item",
  "regex": "`\\$\\{([a-zA-Z_$][\\w$]*)\\.prefix\\} \\$\\{([a-zA-Z_$][\\w$]*\\([a-zA-Z_$][\\w$]*\\.base\\))\\}`",
  "para": "`${$2} ${$1.prefix}`"
 },
 {
  "arquivo": "treeGrowth-",
  "motivo": "Nome base do item (sword -> Espada) na função que transforma id em título",
  "regex": "\\b([a-zA-Z_$][\\w$]*)\\.replace\\(/_/g,\" \"\\)\\.replace\\(/\\\\b\\\\w/g,([a-zA-Z_$][\\w$]*=>[a-zA-Z_$][\\w$]*\\.toUpperCase\\(\\))\\)",
  "para": "(__TABELA_BASE__[$1]||$1.replace(/_/g,\" \").replace(/\\b\\w/g,$2))"
 },
 {
  "arquivo": "persistence-",
  "motivo": "Nome base do item na função que transforma id em título",
  "regex": "String\\(([a-zA-Z_$][\\w$]*)\\)\\.replace\\(/_/g,\" \"\\)\\.replace\\(/\\\\b\\\\w/g,([a-zA-Z_$][\\w$]*=>[a-zA-Z_$][\\w$]*\\.toUpperCase\\(\\))\\)",
  "para": "(__TABELA_BASE__[$1]||String($1).replace(/_/g,\" \").replace(/\\b\\w/g,$2))"
 },
 {
  "arquivo": "index-",
  "motivo": "Renomear em português os itens já gravados no save, ao carregar (_decodeSave)",
  "regex": "([a-zA-Z_$][\\w$]*)\\(([a-zA-Z_$][\\w$]*),\"_decodeSave\"\\)",
  "para": "$&,$2=(function(f,n){return function(){return n(f.apply(this,arguments))}})($2,__NORMALIZADOR_ITENS__)"
 },
 {
  "arquivo": "Roguefort-",
  "motivo": "Ingredientes das receitas mostrados pelo id (fox_pelt -> pele de raposa)",
  "regex": "\\b([a-zA-Z_$][\\w$]*)\\.toString\\(\\)\\.replace\\(/_/g,\" \"\\)",
  "para": "(__TABELA_IDS__[$1]||$1.toString().replace(/_/g,\" \"))"
 },
 {
  "arquivo": "cheeseMaturation-",
  "motivo": "Nome de ingrediente de queijo pelo id (ingredientDisplayName)",
  "regex": "String\\(([a-zA-Z_$][\\w$]*)\\)\\.replace\\(/_/g,\" \"\\)(?=,[a-zA-Z_$][\\w$]*=[a-zA-Z_$][\\w$]*\\(\\1\\);return)",
  "para": "(__TABELA_IDS__[$1]||String($1).replace(/_/g,\" \"))"
 },
 {
  "arquivo": "treeGrowth-",
  "motivo": "Rótulo curto de ingrediente pelo id (shortIngredientLabel)",
  "regex": "\\(([a-zA-Z_$][\\w$]*)&&\\(\\1\\.label\\|\\|\\1\\.id\\|\\|\\1\\.cls\\)\\|\\|\"\"\\)\\.replace\\(/_/g,\" \"\\)",
  "para": "((x)=>(__TABELA_IDS__[x]||x.replace(/_/g,\" \")))($1&&($1.label||$1.id||$1.cls)||\"\")"
 }
]